#!/usr/bin/env bash
# Global Git Pre-Push Secret Guardrail
# Prevents accidental commits of API keys, private keys, and sensitive tokens.

set -euo pipefail

# Read stdin passed by git: <local ref> <local sha1> <remote ref> <remote sha1>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    # Branch deletion, allow
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New remote branch, scan all commits not in origin
    commit_range=$(git rev-list "$local_sha" --not --remotes 2>/dev/null || echo "$local_sha")
  else
    commit_range="$remote_sha..$local_sha"
  fi

  if [ -z "$commit_range" ]; then
    continue
  fi

  # Run Python secret inspector on the diff of outgoing commits
  python3 - <<EOF
import re
import subprocess
import sys

commit_range = "${commit_range}".strip().split()
if not commit_range:
    sys.exit(0)

# Build diff for outgoing commits
try:
    if len(commit_range) == 1:
        diff_cmd = ["git", "diff", f"{commit_range[0]}^!"]
    else:
        diff_cmd = ["git", "diff", "${commit_range}"]
    diff_output = subprocess.check_output(diff_cmd, stderr=subprocess.DEVNULL, text=True)
except Exception:
    # If range syntax fails, diff against HEAD~1
    try:
        diff_output = subprocess.check_output(["git", "diff", "HEAD~1..HEAD"], stderr=subprocess.DEVNULL, text=True)
    except Exception:
        sys.exit(0)

SECRET_PATTERNS = [
    (r"ghp_[A-Za-z0-9_]{36}", "GitHub Personal Access Token"),
    (r"github_pat_[A-Za-z0-9_]{82}", "GitHub Fine-Grained Token"),
    (r"sk-ant-api[0-9]{2}-[A-Za-z0-9_\-]{40,}", "Anthropic API Key"),
    (r"sk-(?:proj-)?[A-Za-z0-9_\-]{40,}", "OpenAI API Key"),
    (r"AIza[0-9A-Za-z_\-]{35}", "Google / Gemini API Key"),
    (r"-----BEGIN (?:RSA|OPENSSH|EC|DSA|PRIVATE) KEY-----", "Private Cryptographic Key"),
    (r"xox[baprs]-[0-9a-zA-Z]{10,48}", "Slack Token"),
    (r"(?:R2_SECRET_ACCESS_KEY|AWS_SECRET_ACCESS_KEY)\s*[:=]\s*[\"']?[A-Za-z0-9/+=]{40}[\"']?", "Cloudflare R2 / AWS Secret Key"),
]

violations = []
current_file = ""

for line in diff_output.splitlines():
    if line.startswith("diff --git"):
        parts = line.split()
        if len(parts) >= 4:
            current_file = parts[3].lstrip("b/")
    # Only scan newly added lines in the diff
    elif line.startswith("+") and not line.startswith("+++"):
        content = line[1:]
        # Skip commented-out examples or doc strings explicitly labelled example/dummy
        if "REDACTED" in content or "example" in content.lower() or "your_" in content.lower():
            continue
        for pattern, label in SECRET_PATTERNS:
            match = re.search(pattern, content)
            if match:
                matched_val = match.group(0)
                # Obfuscate matched string in output
                redacted = matched_val[:4] + "*" * (len(matched_val) - 8) + matched_val[-4:] if len(matched_val) > 8 else "***"
                violations.append((current_file, label, redacted))

if violations:
    print("\n" + "=" * 60)
    print("🚨 PRE-PUSH BLOCKED: HIGH-RISK CREDENTIAL DETECTED")
    print("=" * 60)
    for f, label, red in violations:
        print(f"❌ File: {f}")
        print(f"   Type: {label}")
        print(f"   Match: {red}")
    print("\nPush rejected to prevent credential leak to remote.")
    print("To bypass if this is a verified false-positive, pass: git push --no-verify")
    print("=" * 60 + "\n")
    sys.exit(1)

sys.exit(0)
EOF

done
