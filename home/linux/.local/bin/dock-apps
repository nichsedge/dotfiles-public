#!/usr/bin/env bash
set -euo pipefail

get_launchers() {
    qdbus-qt6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
    var ps = panels();
    for (var i = 0; i < ps.length; i++) {
        if (ps[i].location === "bottom") {
            var ws = ps[i].widgets();
            for (var j = 0; j < ws.length; j++) {
                if (ws[j].type === "org.kde.plasma.icontasks") {
                    ws[j].currentConfigGroup = ["General"];
                    print(ws[j].readConfig("launchers"));
                }
            }
        }
    }
    '
}

set_launchers() {
    local launchers="$1"
    qdbus-qt6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    var ps = panels();
    for (var i = 0; i < ps.length; i++) {
        if (ps[i].location === 'bottom') {
            var ws = ps[i].widgets();
            for (var j = 0; j < ws.length; j++) {
                if (ws[j].type === 'org.kde.plasma.icontasks') {
                    ws[j].currentConfigGroup = ['General'];
                    ws[j].writeConfig('launchers', '$launchers');
                }
            }
        }
    }
    "
}

cmd="${1:-list}"

case "$cmd" in
    list)
        echo "=== Pinned Apps on KDE Dock ==="
        current=$(get_launchers)
        IFS=',' read -ra ADDR <<< "$current"
        i=1
        for item in "${ADDR[@]}"; do
            clean="${item#applications:}"
            clean="${clean#preferred://}"
            echo "  [$i] $clean ($item)"
            ((i++))
        done
        ;;
    add)
        target="${2:-}"
        if [[ -z "$target" ]]; then
            echo "Usage: dock-apps add <app_name_or_desktop_file>"
            exit 1
        fi
        # Find desktop file if only partial name given
        desktop_file=""
        if [[ "$target" == *.desktop ]]; then
            desktop_file="$target"
        else
            found=$(find /usr/share/applications ~/.local/share/applications -name "*${target}*.desktop" 2>/dev/null | head -n 1 || true)
            if [[ -n "$found" ]]; then
                desktop_file=$(basename "$found")
            else
                echo "Error: No desktop file found matching '$target'"
                exit 1
            fi
        fi
        
        current=$(get_launchers)
        entry="applications:$desktop_file"
        if [[ "$current" == *"$entry"* ]]; then
            echo "Already pinned: $desktop_file"
            exit 0
        fi
        
        if [[ -z "$current" ]]; then
            new_launchers="$entry"
        else
            new_launchers="$current,$entry"
        fi
        set_launchers "$new_launchers"
        echo "✓ Pinned $desktop_file to dock!"
        ;;
    remove|rm)
        target="${2:-}"
        if [[ -z "$target" ]]; then
            echo "Usage: dock-apps remove <query_or_index>"
            exit 1
        fi
        current=$(get_launchers)
        IFS=',' read -ra ADDR <<< "$current"
        new_items=()
        removed=""
        
        if [[ "$target" =~ ^[0-9]+$ ]]; then
            idx=1
            for item in "${ADDR[@]}"; do
                if [[ "$idx" -eq "$target" ]]; then
                    removed="$item"
                else
                    new_items+=("$item")
                fi
                ((idx++))
            done
        else
            for item in "${ADDR[@]}"; do
                if [[ "$item" == *"$target"* ]]; then
                    removed="$item"
                else
                    new_items+=("$item")
                fi
            done
        fi
        
        if [[ -z "$removed" ]]; then
            echo "Error: '$target' not found in dock."
            exit 1
        fi
        
        new_launchers=$(IFS=','; echo "${new_items[*]}")
        set_launchers "$new_launchers"
        echo "✓ Removed $removed from dock!"
        ;;
    clear)
        set_launchers ""
        echo "✓ Cleared all dock icons!"
        ;;
    *)
        echo "Usage: dock-apps [list|add <app>|remove <name/index>|clear]"
        ;;
esac
