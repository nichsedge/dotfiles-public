#!/usr/bin/env bash
# cosmic-clipboard: Raycast / Windows-style lightweight clipboard history
set -euo pipefail

# Ensure cliphist daemon is active
if ! pgrep -f "wl-paste.*cliphist" >/dev/null 2>&1; then
    systemctl --user start cliphist.service 2>/dev/null || (wl-paste --watch cliphist store &)
fi

selected=$(cliphist list | wofi --dmenu --prompt "Clipboard…" --lines 10 --width 650)
if [[ -n "${selected:-}" ]]; then
    printf "%s" "$selected" | cliphist decode | wl-copy
    # Brief pause to allow wofi to close and focus to return to previous window
    sleep 0.12
    wtype -M ctrl -k v -m ctrl 2>/dev/null || true
fi
