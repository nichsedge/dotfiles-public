#!/usr/bin/env bash
# cosmic-clipboard: Ultra-fast toggle via direct 2ms D-Bus IPC with native fallback
set -euo pipefail

# 1. Fast-path: Instant 2ms D-Bus toggle if resident
if gdbus call --session \
              --dest dev.nichsedge.cosmic.clipboard \
              --object-path /dev/nichsedge/cosmic/clipboard \
              --method org.gtk.Application.Activate "{}" >/dev/null 2>&1; then
    exit 0
fi

# 2. Fallback: Launch resident binary
exec "${HOME}/Projects/cosmic-clipboard/target/release/cosmic-clipboard" "$@"
