[Desktop Entry]
Name=Clipboard
Comment=Clipboard History for COSMIC
Type=Application
Exec=cosmic-panel-button cosmic-clipboard
Icon=edit-paste-symbolic
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Clipboard;History;
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-HostWaylandDisplay=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
