# Copy to ~/.secrets and chmod 0600. Do not commit real values.
export GIT_EMAIL_PERSONAL="personal@example.com"
export GIT_NAME_PERSONAL="Personal Name"
export GIT_EMAIL_WORK="work@example.com"
export GIT_NAME_WORK="Work Name"
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/Projects/creds/gcp/service-account.json"
